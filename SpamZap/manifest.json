{
  "manifest_version": 3,
  "name": "WhatsApp Spam Detector",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"]
    }
  ]
}
